{
  "name": "luci-theme-aster-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Development-only tooling: builds the Astryx theme and generates tokens.css. The OpenWrt package does not need Node.",
  "scripts": {
    "theme": "astryx theme build design/aster.ts --out design/built/aster.css --icons-specifier ../icons",
    "check:theme": "astryx theme build design/aster.ts --out design/built/aster.css --icons-specifier ../icons --check",
    "tokens": "node scripts/tokens.mjs",
    "check:tokens": "node scripts/tokens.mjs --check",
    "test:tokens": "bash checks/tests/tokens.sh",
    "check:literals": "bash checks/literals.sh",
    "test:literals": "bash checks/tests/literals.sh",
    "check:budget": "bash checks/budget.sh",
    "test:budget": "bash checks/tests/budget.sh"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@astryxdesign/core": "0.7.16",
    "@heroicons/react": "2.2.0",
    "@stylexjs/stylex": "0.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
