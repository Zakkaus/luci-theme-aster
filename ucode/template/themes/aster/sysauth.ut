{#
 Copyright 2026 Zakk <zakk@gentoozh.org>
 Licensed to the public under the Apache License 2.0.

 The login screen, laid out as doona's sign-in page: one card centred on the
 page background, the same on a phone and a desktop; the theme switch and
 palette menu in the page's corner (header.ut, `login`); in the card the
 mark and the device's name, the title with the model and firmware under it
 as secondary text, then the stacked fields and the one action.

 What luci-base needs is kept and nothing else: a plain POST form to this
 URL with luci_username and luci_password, the failed-login message when the
 dispatcher passes fuser, and the authentication plugin slot (auth_message,
 auth_fields, auth_html, auth_assets), which 24.10 and 25.12 do not fill
 today but a dispatcher with plugins does. The form submits without
 JavaScript; the view below only adds focus, the reveal toggle and the busy
 state.
-#}

{% include('header', { blank_page: true, login: true }) %}

{%
	const board = ubus.call('system', 'board') ?? {};
	const hostname = striptags(board.hostname ?? 'OpenWrt');
	const about = filter([ board.model, board.release?.description ], (s) => s);
%}

<main class="login">
	<div class="login-panel">
		{#
		 The device's name as the wordmark: several routers, several tabs, one
		 password field each, so the page says which box it is before it asks
		 for anything. The mark is Ray Floret in the accent, bare.
		-#}
		<div class="login-brand">
			<svg class="login-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(60 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(120 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(180 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(240 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(300 12 12)"/></svg>
			<span>{{ hostname }}</span>
		</div>

		<div class="login-head">
			<h1>{{ _('Authorization Required') }}</h1>
			{% if (length(about)): %}
			<p class="login-note">{{ join(' · ', map(about, (s) => striptags(s))) }}</p>
			{% endif %}
		</div>

		{#
		 Two independent facts, so two independent banners: with a second factor
		 enabled the dispatcher fills auth_message before it checks the
		 password, and a wrong password must still be reported as one.
		-#}
		{% if (fuser): %}
		<div class="alert-message error" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
		{% endif %}
		{% if (auth_message): %}
		<div class="alert-message{{ auth_plugin ? ' warning' : '' }}" role="status">{{ auth_message }}</div>
		{% endif %}

		<form class="login-form" method="post">
			<div class="login-field">
				<label for="luci_username">{{ _('Username') }}</label>
				<input name="luci_username" id="luci_username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" value="{{ entityencode(duser ?? '', true) }}">
			</div>
			<div class="login-field">
				<label for="luci_password">{{ _('Password') }}</label>
				<div class="login-secret">
					<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
					{#
					 Heroicons 2.2.0 outline Eye and EyeSlash (MIT,
					 LICENSES/heroicons-MIT.txt). Hidden until the view binds it: a
					 toggle that cannot toggle is a dead stop in the tab order.
					-#}
					<button class="login-reveal" type="button" aria-controls="luci_password" aria-pressed="false" aria-label="{{ _('Reveal/hide password') }}" title="{{ _('Reveal/hide password') }}" hidden>
						<svg class="ico show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
						<svg class="ico hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/></svg>
					</button>
				</div>
			</div>
			{% for (let field in auth_fields ?? []): %}
			<div class="login-field">
				<label for="{{ field.name }}">{{ _(field.label ?? field.name) }}</label>
				<input
					name="{{ field.name }}"
					id="{{ field.name }}"
					type="{{ field.type ?? 'text' }}"
					{% if (field.placeholder): %}placeholder="{{ field.placeholder }}"{% endif %}
					{% if (field.inputmode): %}inputmode="{{ field.inputmode }}"{% endif %}
					{% if (field.pattern): %}pattern="{{ field.pattern }}"{% endif %}
					{% if (field.maxlength): %}maxlength="{{ field.maxlength }}"{% endif %}
					{% if (field.autocomplete): %}autocomplete="{{ field.autocomplete }}"{% endif %}
					{% if (field.required): %}required{% endif %}
				>
			</div>
			{% endfor %}
			{% if (auth_html): %}
			<div class="login-extra">{{ auth_html }}</div>
			{% endif %}
			{% for (let asset in auth_assets ?? []): %}
				{% if (asset.type == 'script'): %}<script src="{{ asset.src }}"></script>{% endif %}
			{% endfor %}

			<button class="login-submit" type="submit">{{ _('Log in') }}</button>
		</form>
	</div>
</main>

{#
 The view only takes over once L exists. Without JavaScript the form above
 still submits: the button is a real submit button, not a click handler.
-#}
<div id="view" hidden></div>
<script>
	L.require('ui').then(function(ui) {
		ui.instantiateView('aster.sysauth');
	});
</script>

{% include('footer', { blank_page: true }) %}
