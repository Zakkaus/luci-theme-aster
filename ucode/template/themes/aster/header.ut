{#
 Copyright 2026 Zakk <zakk@gentoozh.org>
 Licensed to the public under the Apache License 2.0.

 The document shell: a top bar across the width, the side nav and the main
 column under it (shell.css). This template's job is to emit the structure
 that stylesheet expects and nothing more.

 The ids are LuCI's and are not negotiable: #maincontent, #indicators,
 #tabmenu, #modemenu, plus the body's lang_ class and data-page attribute.

 The brand mark is the theme's logo, Ray Floret: six quills round the
 centre, drawn in the palette's accent with no badge behind it. logo.svg
 (the favicon) is the same mark, bare, in Rosé Pine's accent; theme-aster.js
 redraws it in the page's accent.

 The other icons are Heroicons 2.2.0 outline (MIT,
 https://github.com/tailwindlabs/heroicons), the path data copied verbatim
 from @heroicons/react/24/outline into ICONS below; the licence is in
 LICENSES/heroicons-MIT.txt.

 The side nav is rendered here, not by script, so it is in the first paint
 and stands still across page loads; the top bar and the side nav carry
 view-transition names (shell.css), so a page change cross-fades only the
 content.
-#}

{%
	import { getuid, getspnam } from 'luci.core';
	import * as fs from 'fs';

	const boardinfo = ubus.call('system', 'board') ?? {};

	// Which of the three registered media paths this request came through.
	// That is the device-level default: LuCI already owns the selection UI
	// and the persistence, so the theme does not build a second one.
	//
	// Three states, all three explicit. A theme with only "dark" and "not
	// dark" cannot say "light regardless of the system", and an unknown value
	// falls silently into whichever branch is last.
	const mode = (theme == 'aster-dark') ? 'dark'
	           : (theme == 'aster-light') ? 'light'
	           : 'auto';

	// The browser chrome colour. There are two of them, because in auto mode
	// the answer is not known server-side: the page follows the device, so the
	// bar has to as well. Both carry a media query and the explicit modes pin
	// both to the same value — a single unconditional tag reported a light bar
	// over a dark page on every phone that paints it.
	// The values are the default palette's (Rosé Pine) shell background,
	// --color-background-body; the head script below and theme-aster.js
	// replace them with the chosen palette's from the stylesheet.
	const barlight = (mode == 'dark') ? '#191724' : '#FAF4ED';
	const bardark  = (mode == 'light') ? '#FAF4ED' : '#191724';

	// The palettes a reader can pick (design/palettes.mjs; Rosé Pine, the
	// default, first, then Aster). The slug is the data-palette value and the
	// localStorage "aster-palette" value; scripts/tokens.mjs checks that
	// this list matches the palettes it writes into tokens.css.
	const palettes = [
		[ 'rose-pine', 'Rosé Pine' ],
		[ 'aster', 'Aster' ],
		[ 'relay', 'Relay Blue' ],
		[ 'teal', 'Sounding Teal' ],
		[ 'plum', 'Herbarium Plum' ],
	];

	// Heroicons 2.2.0 outline (MIT, https://github.com/tailwindlabs/heroicons):
	// the path data of each icon in @heroicons/react/24/outline, verbatim,
	// drawn with the set's own 1.5 stroke. The licence is in
	// LICENSES/heroicons-MIT.txt.
	const ICONS = {
		ChartBarSquare: 'M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z',
		CpuChip: 'M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9v-9Z',
		Squares2X2: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z',
		GlobeAlt: 'M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418',
		ShieldCheck: 'M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z',
		CircleStack: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
		ArrowRightStartOnRectangle: 'M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9',
		ChevronDown: 'm19.5 8.25-7.5 7.5-7.5-7.5',
		ComputerDesktop: 'M9 17.25v1.007a3 3 0 0 1-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0 1 15 18.257V17.25m6-12V15a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 15V5.25m18 0A2.25 2.25 0 0 0 18.75 3H5.25A2.25 2.25 0 0 0 3 5.25m18 0V12a2.25 2.25 0 0 1-2.25 2.25H5.25A2.25 2.25 0 0 1 3 12V5.25',
		Sun: 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z',
		Moon: 'M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z',
		Bars3: 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5',
		XMark: 'M6 18 18 6M6 6l12 12',
		ChevronLeft: 'M15.75 19.5 8.25 12l7.5-7.5',
	};

	// The brand mark (Ray Floret): six quills round the centre.
	const mark = '<svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(60 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(120 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(180 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(240 12 12)"/><path d="M10.4 8.6C8.9 6.1 10.6 3.3 13.5 1.6C14.9 4.6 14.1 7.5 12.8 9.1Z" transform="rotate(300 12 12)"/></svg>';

	function svg(name, attrs) {
		return `<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"${attrs ?? ''}><path d="${ICONS[name]}"/></svg>`;
	}

	// A span, the side nav's icon host (shell.css .ico-host).
	const ico = (name, cls) => `<span class="${cls ?? 'ico-host'}" aria-hidden="true">${svg(name)}</span>`;

	// The three colour schemes: the stored value, the label, the icon.
	const schemes = [
		[ 'auto', _('Auto'), 'ComputerDesktop' ],
		[ 'light', _('Light'), 'Sun' ],
		[ 'dark', _('Dark'), 'Moon' ],
	];

	// The appearance control: one IconButton showing the scheme in force and
	// one Menu (doona's ChoiceMenu with a scheme section and a palette
	// section; Astryx DropdownMenu sections: a heading, the rows, a divider).
	// The same control in the top bar and in the login page's corner;
	// theme-aster.js drives every copy. `id` keeps each menu's id unique.
	function appearance(id) {
		const label = entityencode(_('Design'), true);
		let rows = `<li class="menu-heading" role="presentation" aria-hidden="true">${_('Theme')}</li>`;

		for (let s in schemes)
			rows += `<li role="menuitemradio" tabindex="-1" aria-checked="false" data-group="scheme" data-value="${s[0]}">${svg(s[2])}${s[1]}</li>`;

		rows += `<li role="separator"></li><li class="menu-heading" role="presentation" aria-hidden="true">${_('Palette')}</li>`;

		for (let p in palettes)
			rows += `<li role="menuitemradio" tabindex="-1" aria-checked="false" data-group="palette" data-value="${p[0]}"><span class="palette-swatch" data-swatch="${p[0]}"></span>${p[1]}${(p[0] == palettes[0][0]) ? ' <small>' + _('Default') + '</small>' : ''}</li>`;

		return `<div class="palette-menu"><button class="icon-btn appearance" type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="appearance-${id}" aria-label="${label}" data-tooltip="${label}">` +
			`${svg('ComputerDesktop', ' data-scheme="auto"')}${svg('Sun', ' data-scheme="light"')}${svg('Moon', ' data-scheme="dark"')}</button>` +
			`<ul id="appearance-${id}" role="menu" aria-label="${label}" hidden>${rows}</ul></div>`;
	}

	// The side nav, rendered here so it is part of the first paint and stands
	// still from one page to the next. The tree is the one the admin/menu
	// request answers with (dispatcher.menu_json with the session's ACLs),
	// filtered and ordered as luci-base's ui.menu does it (ui.js scrubMenu
	// and getChildren); menu-aster.js adds the behaviour and the tab row.
	const menutree = blank_page ? null : dispatcher.menu_json(ctx?.authacl ?? {});

	// scrubMenu: a firstchild node with no shown child of its own is not
	// satisfied either.
	function shown(node) {
		if (!node?.satisfied)
			return false;

		if (node.action?.type != 'firstchild')
			return true;

		for (let k, c in node.children)
			if (c.title && !c.firstchild_ineligible && shown(c))
				return true;

		return false;
	}

	// getChildren: shown children with a title, an alias or rewrite taking
	// its target's children, sorted by order and then by name.
	function kids(node) {
		let out = [];

		for (let k, c in node?.children) {
			if (!shown(c) || !exists(c, 'title'))
				continue;

			let n = { ...c, name: k };

			if (type(c.action) == 'object' && c.action.path != null && (c.action.type == 'alias' || c.action.type == 'rewrite')) {
				let r = menutree;

				for (let s in split(c.action.path, '/'))
					r = (type(r?.children) == 'object') ? r.children[s] : null;

				if (r)
					n = { ...n, children: r.children, action: r.action };
			}

			push(out, n);
		}

		return sort(out, (a, b) => {
			if ((a.order ?? 1000) != (b.order ?? 1000))
				return (a.order ?? 1000) - (b.order ?? 1000);

			return (lc(a.name) < lc(b.name)) ? -1 : (lc(a.name) > lc(b.name)) ? 1 : 0;
		});
	}

	// Top-level path segment -> icon, as the reference's luci:* keys. A group
	// not listed (a package's own top-level entry) gets the services grid.
	const ICON_FOR = {
		status: 'ChartBarSquare',
		system: 'CpuChip',
		services: 'Squares2X2',
		network: 'GlobeAlt',
		vpn: 'ShieldCheck',
		nas: 'CircleStack',
		storage: 'CircleStack',
		logout: 'ArrowRightStartOnRectangle',
	};

	// A SideNavItem. aria-label names it when the rail hides the text; only a
	// top-level page carries an icon, a page under a group is indented to the
	// group's label instead.
	function navitem(href, title, active, icon) {
		const t = entityencode(_(title), true);

		return `<a class="nav-item" href="${href}" aria-label="${t}"${active ? ' data-active aria-current="page"' : ''}>${icon ? ico(icon) : ''}<span>${t}</span></a>`;
	}

	// The modes (one, "admin", on a stock install) and the one in use: the
	// request's first segment, or the first mode.
	const reqpath = ctx?.request_path ?? [];
	const curpath = ctx?.path ?? [];
	const modes = menutree ? kids(menutree) : [];
	let curmode = null;

	for (let i, m in modes)
		if (length(reqpath) ? m.name == reqpath[0] : i == 0)
			curmode = m;

	// Cache buster for the theme's own stylesheets. Without it a browser keeps
	// the CSS it already has: LuCI versions luci.js and cbi.js this way, but a
	// theme's sheets carry no version at all, so an edited stylesheet reaches
	// nobody who has the page open — every change looks like it did nothing.
	// The newest mtime among the five is the version; a package upgrade moves
	// it for the same reason an edit does.
	let assetver = 0;
	for (let f in [ 'tokens', 'components', 'shell', 'theme', 'luci' ]) {
		const st = fs.stat(`/www${media}/${f}.css`);
		if (st?.mtime > assetver)
			assetver = st.mtime;
	}

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}"{{ mode != 'auto' ? ` data-theme="${mode}"` : '' }} data-scheme="{{ mode }}">
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${boardinfo.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="theme-color" id="aster-bar-light" content="{{ barlight }}" media="(prefers-color-scheme: light)">
		<meta name="theme-color" id="aster-bar-dark" content="{{ bardark }}" media="(prefers-color-scheme: dark)">
		{# Dark Reader would repaint a page that already has a dark theme. #}
		<meta name="darkreader-lock">
		{#
		 The per-browser overrides on top of the device default, and they run
		 here — in the head, before the first stylesheet — or a reader who
		 chose dark, or another palette, gets the wrong frame on every page
		 load.

		 This script reads the stored choices and writes the attributes; the
		 browser bar colours follow once the stylesheets are in.
		-#}
		<script>
			(function () {
				var root = document.documentElement;
				var v = null, p = null;

				try {
					v = localStorage.getItem('aster-theme');
					p = localStorage.getItem('aster-palette');
				}
				catch (e) {
					/* A private window and blocked site data both throw here.
					   The server-rendered attribute is already a correct
					   answer, so there is nothing to recover. */
				}

				/* Rosé Pine is the :root palette and carries no attribute;
				   a stored value that is not a palette falls back to it. */
				if ({{ sprintf('%J', map(slice(palettes, 1), (e) => e[0])) }}.indexOf(p) >= 0)
					root.setAttribute('data-palette', p);

				/* 'auto' leaves the attribute too. Auto means "no override of
				   my own", and the attribute the server rendered is exactly
				   that answer — removing it turned a device set to aster-dark
				   into a light page one reload after the reader asked to
				   follow the device. */
				if (v === 'light' || v === 'dark')
					root.setAttribute('data-theme', v);

				/* The scheme in force, which the appearance button draws
				   (shell.css): the stored choice, else the device default. */
				if (v === 'auto' || v === 'light' || v === 'dark')
					root.setAttribute('data-scheme', v);

				/* The phone paints its chrome from these: the palette's shell
				   colour, read from the stylesheet once it applies. An
				   explicit mode pins both, or the phone keeps painting from
				   the system setting the reader overrode. theme-aster.js
				   repeats this after a change. */
				document.addEventListener('DOMContentLoaded', function () {
					var m = /light-dark\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)/.exec(getComputedStyle(root).getPropertyValue('--color-background-body'));
					var l = document.getElementById('aster-bar-light');
					var d = document.getElementById('aster-bar-dark');
					var t = root.getAttribute('data-theme');

					if (!m || !l || !d)
						return;

					l.setAttribute('content', t === 'dark' ? m[2] : m[1]);
					d.setAttribute('content', t === 'light' ? m[1] : m[2]);
				});
			})();

			/* The collapsed sidebar, restored here for the same reason as the
			   theme: applied after first paint it is a visible jump, and this
			   one moves every word on the page sideways. */
			(function () {
				try {
					if (localStorage.getItem('aster-rail') === '1')
						document.documentElement.setAttribute('data-rail', '');
				}
				catch (e) { /* no stored preference is a valid answer */ }
			})();
		</script>
		{#
		 Five sheets in dependency order. The first three are verbatim copies
		 of the design system and are never edited in place; theme.css is
		 what this project adds on top; luci.css maps luci-base's own DOM onto
		 all of it.
		-#}
		<link rel="stylesheet" href="{{ media }}/tokens.css?v={{ assetver }}">
		<link rel="stylesheet" href="{{ media }}/components.css?v={{ assetver }}">
		<link rel="stylesheet" href="{{ media }}/shell.css?v={{ assetver }}">
		<link rel="stylesheet" href="{{ media }}/theme.css?v={{ assetver }}">
		<link rel="stylesheet" href="{{ media }}/luci.css?v={{ assetver }}">
		<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
		{% if (dispatched?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ dispatched.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js"></script>
		{#
		 Guard the translation functions.

		 cbi.js declares _() and N_() as global functions, and a global function
		 is a writable property of window — so any script that later assigns
		 window._ replaces LuCI's translator for the whole page. Several browser
		 extensions inject Underscore, which does exactly that: _('Overview')
		 then returns a wrapper object instead of a string, every label falls
		 back to English, and the first view that reaches _(…).format(…) throws
		 "_(...).format is not a function" and never renders.

		 A property can be made read-only without being configurable, so this
		 costs nothing and changes nothing for LuCI, which never reassigns
		 either name. It only makes the later clobbering fail silently, which is
		 what an injected script overwriting an application's globals deserves.
		-#}
		<script>
			(function () {
				[ '_', 'N_' ].forEach(function (name) {
					try {
						var fn = window[name];

						/* Only LuCI's own. If something already replaced it before
						   this ran, freezing the replacement would be worse than
						   leaving it. */
						if (typeof fn !== 'function' || !/window\.TR/.test(String(fn)))
							return;

						Object.defineProperty(window, name, { value: fn, writable: false });
					}
					catch (e) { /* nothing to protect, and nothing to report */ }
				});
			})();
		</script>
	</head>

	<body class="lang_{{ dispatcher.lang }}" data-theme-default="{{ mode }}" data-page="{{ entityencode(join('-', length(ctx.request_path) ? ctx.request_path : ctx.path), true) }}">
		{% if (!blank_page): %}
		<div class="shell">
			{#
			 TopNav: the brand on the start side — the NavIcon mark and the host
			 name, which is the one piece of text saying which of several
			 devices this tab is pointed at — and the page-level controls on the
			 end side, every one a ghost IconButton with a tooltip, as doona's
			 top bar: LuCI's indicators (menu-aster.js), the appearance menu
			 and, on a phone, the drawer toggle.
			-#}
			<header class="shell-header">
				<a class="brand" href="{{ dispatcher.build_url('admin') }}">
					<span class="mark" aria-hidden="true">{{ mark }}</span>
					<span class="brand-text">
						<span class="name">{{ boardinfo.hostname ?? 'OpenWrt' }}</span>
						{% if (boardinfo.model): %}<span class="sub">{{ boardinfo.model }}</span>{% endif %}
					</span>
				</a>
				<div class="hdr-actions">
					<div id="indicators"></div>
					{{ appearance('top') }}
					<button class="icon-btn" id="sidebar-toggle" type="button"
						aria-expanded="false" aria-controls="sidebar" aria-label="{{ _('Navigation') }}">{{ svg('Bars3') }}</button>
				</div>
			</header>

			<aside class="shell-aside" id="sidebar" aria-label="{{ _('Navigation') }}">
				<div class="drawer-head">
					<a class="brand" tabindex="-1" href="{{ dispatcher.build_url('admin') }}">
						<span class="mark" aria-hidden="true">{{ mark }}</span>
						<span class="brand-text">
							<span class="name">{{ boardinfo.hostname ?? 'OpenWrt' }}</span>
							{% if (boardinfo.model): %}<span class="sub">{{ boardinfo.model }}</span>{% endif %}
						</span>
					</a>
					<button class="icon-btn" id="sidebar-close" type="button" aria-label="{{ _('Close') }}">{{ svg('XMark') }}</button>
				</div>
				{#
				 SideNav: a group row per top-level entry (icon, label, chevron)
				 and its pages under it; a top-level page with no children
				 (Logout) is a row with an icon. A group is collapsed unless it
				 holds the current page: seven groups with fifty-nine items
				 measured 3196px on a box with services installed. The script
				 after the side nav reopens what the reader had open on the
				 last page and puts the list back where it was scrolled.
				-#}
				<nav class="nav" id="mainmenu" aria-label="{{ _('Navigation') }}">
					{%- if (curmode): for (let g in kids(curmode)): -%}
					{%- let items = kids(g), cur = (curpath[1] == g.name), t = entityencode(_(g.title), true); -%}
					{%- if (!length(items)): -%}
					<div class="nav-group">{{ navitem(dispatcher.build_url(curmode.name, g.name), g.title, cur, ICON_FOR[g.name] ?? 'Squares2X2') }}</div>
					{%- else -%}
					<div class="nav-group" data-name="{{ entityencode(g.name, true) }}"{{ cur ? '' : ' data-collapsed' }}>
						<div class="nav-label" role="button" tabindex="0" aria-expanded="{{ cur ? 'true' : 'false' }}" aria-label="{{ t }}">{{ ico(ICON_FOR[g.name] ?? 'Squares2X2') }}<span>{{ t }}</span>{{ ico('ChevronDown', 'ico-host chevron') }}</div>
						{%- for (let c in items): -%}
						{{ navitem(dispatcher.build_url(curmode.name, g.name, c.name), c.title, cur && curpath[2] == c.name) }}
						{%- endfor -%}
					</div>
					{%- endif -%}
					{%- endfor; endif -%}
				</nav>
				{# The mode row only earns its place with more than one mode. #}
				<ul id="modemenu"{{ (length(modes) > 1) ? '' : ' hidden' }}>
					{%- for (let m in modes): -%}
					<li><a class="nav-item" href="{{ dispatcher.build_url(m.name) }}" aria-label="{{ entityencode(_(m.title), true) }}"{{ (m === curmode) ? ' data-active aria-current="true"' : '' }}><span>{{ entityencode(_(m.title), true) }}</span></a></li>
					{%- endfor -%}
				</ul>
				<button class="icon-btn rail-toggle" id="rail-toggle" type="button"
					aria-expanded="true" aria-controls="sidebar" aria-label="{{ _('Collapse') }}" data-tooltip="{{ _('Collapse') }}">{{ svg('ChevronLeft') }}</button>
			</aside>
			{#
			 The side nav as the reader left it on the last page, before the
			 first paint: the groups they had open and its scroll position
			 (sessionStorage "aster-nav", written as the page goes).
			-#}
			<script>
				(function () {
					var side = document.getElementById('sidebar');
					var s = null;

					try { s = JSON.parse(sessionStorage.getItem('aster-nav')); }
					catch (e) { /* no stored state: the server's is the answer */ }

					if (s && Array.isArray(s.open)) {
						side.querySelectorAll('.nav-group[data-name]').forEach(function (g) {
							if (s.open.indexOf(g.getAttribute('data-name')) < 0)
								return;

							g.removeAttribute('data-collapsed');
							g.querySelector('.nav-label').setAttribute('aria-expanded', 'true');
						});
						side.scrollTop = +s.top || 0;
					}

					window.addEventListener('pagehide', function () {
						var open = [];

						side.querySelectorAll('.nav-group[data-name]:not([data-collapsed])').forEach(function (g) {
							open.push(g.getAttribute('data-name'));
						});

						try { sessionStorage.setItem('aster-nav', JSON.stringify({ open: open, top: side.scrollTop })); }
						catch (e) { /* private window: the next page starts from the server's state */ }
					});
				})();
			</script>

			<div class="shell-main">
				<div class="shell-content" id="maincontent">
					<div class="shell-inner">
						{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
							<div class="alert-message warning">
								<h4>{{ _('No password set!') }}</h4>
								<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
								{% if (dispatcher.lookup("admin/system/admin")): %}
								  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						{% if (boardinfo.rootfs_type == "initramfs"): %}
							<div class="alert-message warning">
								<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
								<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
								{% if (dispatcher.lookup("admin/system/flash")): %}
								  <div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
								{% endif %}
							</div>
						{% endif %}

						<noscript>
							<div class="alert-message warning">
								<h4>{{ _('JavaScript required!') }}</h4>
								<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
							</div>
						</noscript>

						<div id="tabmenu" hidden></div>
		{% elif (login): %}
		{#
		 The login page has no top bar, so its appearance control — the same
		 one as the top bar's — sits in the page's corner, as on doona's
		 sign-in page. theme-aster.js drives it through the login view.
		-#}
		<header class="login-controls">
			{{ appearance('login') }}
		</header>
		{% endif %}
